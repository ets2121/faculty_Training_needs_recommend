# Frontend Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# System Identity & Branding Configuration (Optional Overrides)
# These override values defined in src/config/systemConfig.ts
# NEXT_PUBLIC_SYSTEM_NAME="QSU Faculty Training Needs Recommender System"
# NEXT_PUBLIC_SYSTEM_SHORT_NAME="QSU Recommender"
# NEXT_PUBLIC_SYSTEM_ABBREVIATION="QSU-TRS"
# NEXT_PUBLIC_SYSTEM_VERSION="2.0"
# NEXT_PUBLIC_SYSTEM_TAGLINE="Multi-Campus Training Needs Recommender"
# NEXT_PUBLIC_PORTAL_NAME="QSU Portal"
# NEXT_PUBLIC_INSTITUTION_NAME="Quirino State University"
# NEXT_PUBLIC_INSTITUTION_SHORT_NAME="QSU"

# Quick Login / Seed Accounts on Login Page
# Set to 'false' in production if you wish to hide test credentials
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=false
NEXT_PUBLIC_ENABLE_QUICK_LOGIN=false
