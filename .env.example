# ==============================================================================
# QSU Faculty Training Needs Recommender — Environment Template (.env.example)
# ==============================================================================
# Copy this file to .env and fill in your real environment values.
# NEVER commit your real .env file to Git!

# --- Application Configuration ---
APP_NAME=QSU Faculty Training Needs Recommender
APP_ENV=development
API_V1_PREFIX=/api/v1

# --- MySQL Database Configuration ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=qsu_recommender
DATABASE_URL=mysql+pymysql://root:@localhost:3306/qsu_recommender

# --- Security & JWT Authentication ---
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
ADMIN_API_KEY=replace-with-a-secure-admin-api-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- File Paths & Directories ---
MODEL_DIR=./models
RAW_DATA_PATH=./data/raw/faculty_training.csv
TRAINING_CATALOG_PATH=./data/raw/training_catalog.csv

# --- CORS & Logging ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO
